{
  "name": "schedule-application",
  "version": "1.0.0",
  "private": true,
  "description": "我的日程 - 网页端与安卓端共享代码（Capacitor）",
  "scripts": {
    "build:native": "esbuild native/src/bridge.js --bundle --minify --format=iife --outfile=schedule-app/native-bridge.js",
    "sync:android": "npm run build:native && cap sync android",
    "android:icons": "powershell -ExecutionPolicy Bypass -File scripts/generate-android-icons.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "esbuild": "^0.24.0"
  }
}
